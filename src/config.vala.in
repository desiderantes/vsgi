using GLib;

namespace VSGI {
	namespace Version {
		public const string FULL = "@VERSION@";
		public const uint MAJOR = @MAJOR_VERSION@;
		public const uint MINOR = @MINOR_VERSION@;
		public const uint MICRO = @MICRO_VERSION@;
		public const string SUFFIX = "@VERSION_SUFFIX@";
		public const string API = "@API_VERSION@";
		
		public static uint get_major_version() {
			return MAJOR;
		}
		
		public static uint get_minor_version () {
			return MINOR;
		}
		
		public static uint get_micro_version () {
			return MICRO;
		}
		public static string get_version () {
			return FULL;
		}
		
		public static string get_version_suffix () {
			return SUFFIX;
		}
		
		public static bool has_version_suffix () {
			return SUFFIX != "";
		}
		
		public static string get_api_version () {
			return API;
		}
	}
}